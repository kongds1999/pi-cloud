# --- frontend (Next.js) -------------------------------------------------------
# Backend address for server-side rewrites (/api/cloud/* -> FastAPI /api/v1/*).
# The browser always calls same-origin /api/cloud, so this is server-only.
API_URL=http://localhost:8000

