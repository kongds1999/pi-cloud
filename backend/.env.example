# --- storage ---------------------------------------------------------------
# Leave both empty for the zero-config in-memory dev store.
# Set both to persist in Supabase Postgres (schema: cloud/db/schema.sql).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Owner id stamped on all writes until real auth lands (Phase 3).
# For Supabase mode: create a user in Dashboard > Authentication, paste its
# UUID here; the backend upserts the matching cloud_profiles row on boot.
DEV_OWNER_ID=00000000-0000-0000-0000-000000000000

# Browsers allowed to call the API directly (the Next.js dev server default).
CORS_ORIGINS=http://localhost:30141
